# ============================================================
#  Select Mobility TMS - configuration template
#  Copy this file to ".env" and edit the values.
#  Never commit the real ".env" file to source control.
# ============================================================

# --- Server -------------------------------------------------
# Most cloud hosts inject PORT automatically. Leave this as is.
PORT=4000

# Bind address.
#   0.0.0.0   = reachable from other machines (needed on cloud hosts)
#   127.0.0.1 = this machine only (recommended behind a reverse proxy)
HOST=0.0.0.0

# --- Data storage -------------------------------------------
# Path to the JSON data file, relative to the project root.
DATABASE_FILE=server/data/tms.db

# --- First-run administrator --------------------------------
# These values only apply when the database is created for the first time.
# Change the password from the app afterwards.
ADMIN_EMAIL=admin@selectmobility.in
ADMIN_PASSWORD=Select@2026
ADMIN_NAME=Fleet Administrator

# Optional separate live administrator. Demo accounts remain available for
# partner presentations; this account is never shown on the login screen.
# LIVE_ADMIN_EMAIL=transport.admin@selectmobility.in
# LIVE_ADMIN_PASSWORD=replace-with-a-strong-password
# LIVE_ADMIN_NAME=Live Transport Administrator
# GPS_PROVIDER=jiothings
# GPS_INGEST_KEY=replace-with-a-long-random-webhook-key

# Session token lifetime in hours
SESSION_HOURS=12

# Company details printed on reports
COMPANY_NAME=Select Mobility India Private Limited
COMPANY_CITY=Pune, Maharashtra, India

# ============================================================
#  OPTIONAL - Cloudflare D1 persistence
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
# D1 takes precedence over the older S3/R2 mirror when configured.
#
#  OPTIONAL - Remote data persistence
# ============================================================
# Free cloud hosts (Render, Railway, Fly.io) wipe the disk on every restart,
# deploy and scale event. Without remote persistence your records are lost each
# time. Configure an S3-compatible bucket below to keep data permanently.
#
# Works with:
#   Cloudflare R2  - 10 GB free, no egress fees  (recommended)
#   Backblaze B2   - 10 GB free
#
# Leave all five blank to run on the local file only (fine for your own PC).
#
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=select-mobility-tms
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_KEY=tms.db

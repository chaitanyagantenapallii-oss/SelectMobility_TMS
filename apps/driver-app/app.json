{
  "expo": {
    "name": "SMI Driver",
    "slug": "smi-driver",
    "version": "1.1.0",
    "orientation": "portrait",
      "icon": "./assets/smipl-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "smidriver",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b4ed8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.selectmobility.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "Not used. Declared for store review completeness.",
        "NSLocationWhenInUseUsageDescription": "Shown to the transport office while you are on a trip, so they can see where the vehicle is.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "in.selectmobility.driver",
      "versionCode": 3,
        "adaptiveIcon": {
          "foregroundImage": "./assets/smipl-logo.png",
          "backgroundColor": "#ffffff"
        },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiOrigin": "https://select-mobility-tms.onrender.com",
      "eas": {
        "projectId": "8febcb3b-42d3-4987-8637-dcb3c2991e48"
      }
    },
    "owner": "selectmobility"
  }
}

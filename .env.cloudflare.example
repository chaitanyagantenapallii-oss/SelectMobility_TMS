# ============================================================
#  Select Mobility TMS - Cloudflare connection template
#  Copy these values into your real .env file or cloud host
#  environment variables. Do not commit real credentials.
# ============================================================

# --- Cloudflare R2 backup storage ---------------------------
# Create a private R2 bucket named "select-mobility-tms", then create an
# R2 API token scoped to this bucket with Object Read & Write access.

BACKUP_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=select-mobility-tms
BACKUP_S3_ACCESS_KEY_ID=<r2-access-key-id>
BACKUP_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
BACKUP_S3_REGION=auto
BACKUP_S3_KEY=tms.db

# Optional but strongly recommended for production.
ADMIN_EMAIL=admin@selectmobility.in
ADMIN_PASSWORD=<replace-with-a-strong-password>
SESSION_HOURS=12

